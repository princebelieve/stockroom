# Copy this file to .env for local development. Never commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_DATABASE=stockroom_sync
JWT_SECRET=generate-a-long-random-secret
ADMIN_API_KEY=generate-a-different-long-random-secret
SYNC_API_URL=http://localhost:8080
BUSINESS_ID=client-001
DEVICE_ID=client-001-pc-01
SYNC_DEVICE_TOKEN=jwt-issued-by-the-sync-api

# Server-only Gmail API OAuth 2.0 credentials. Never place these in a client app.
GMAIL_USER=your-sending-address@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Render-only subscription settings. SUBSCRIPTION_PUBLIC_URL is the Vercel app URL.
PAYSTACK_SECRET_KEY=
SUBSCRIPTION_PUBLIC_URL=https://your-business-app.example.com
DEVELOPER_EMAIL=you@example.com

# Public landing page and installer release URLs (never put secrets in VITE_ variables)
VITE_PUBLIC_APP_URL=https://stockroom.globalcreest.com/
VITE_APK_DOWNLOAD_URL=
VITE_DESKTOP_DOWNLOAD_URL=
# Add the app's production origin to PWA_ALLOWED_ORIGINS on the cloud service.
PWA_ALLOWED_ORIGINS=https://your-business-app.example.com
